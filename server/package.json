{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && esbuild src/api.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/bundle/api.mjs",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-reporter spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.28.2"
  }
}
